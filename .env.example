# ---- Baked into the app at build time (safe to ship; not secrets) ----

# Your deployed Vercel project origin, e.g. https://scrapscout.vercel.app
VITE_API_BASE_URL=

# App key sent as X-App-Key. Must match APP_SHARED_KEY on the server.
# Use a FRESH key for ScrapScout — don't reuse CashScan's.
# Generate:  openssl rand -hex 24
VITE_APP_KEY=

# ---- Set on the Vercel project (Settings > Environment Variables), ----
# ---- NEVER in this file.                                            ----
#
# ANTHROPIC_API_KEY=sk-ant-...      (required; set a spend cap in the console)
# APP_SHARED_KEY=...                (same value as VITE_APP_KEY above)
# ANTHROPIC_MODEL=claude-sonnet-4-6 (optional override; this is the default)
